{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "rewrites": [
    {
      "source": "/publicinfohub",
      "destination": "/index.html"
    },
    {
      "source": "/publicinfohub/",
      "destination": "/index.html"
    },
    {
      "source": "/publicinfohub/:path*",
      "destination": "/:path*"
    }
  ]
}
